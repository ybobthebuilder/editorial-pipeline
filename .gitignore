# .gitignore

# Local env and secrets
.env
.env.*
!.env.example

# PDFs and generated artifacts
*.pdf
*.PDF
exports/
data/
outputs/
results/
artifacts/

# Node / JS tooling
node_modules/
.npm/
coverage/

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
logs/

# Private data and non-public fixtures
private/
editorial-intel/

# Temporary files
*.tmp
*.swp

# Python (if used later)
__pycache__/
*.pyc

# n8n local exports
n8n/workflows/*.local.json
n8n/workflows/*.private.json

# Keep only public fixtures and docs tracked
!fixtures/synthetic/
!fixtures/synthetic/**
